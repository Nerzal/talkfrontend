{
  "name": "talkfrontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run talks:index",
    "dev": "vite",
    "prebuild": "npm run talks:index",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema": "node scripts/generate-schemas.cjs",
    "talks:index": "node scripts/generate-talks-index.cjs"
  },
  "dependencies": {
    "@shikijs/magic-move": "^4.3.1",
    "js-yaml": "^5.2.1",
    "prismjs": "^1.30.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "shiki": "^4.3.1",
    "simple-icons": "^16.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^3.0.0",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.0.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}

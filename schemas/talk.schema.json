{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Talk",
  "definitions": {
    "Talk": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "year": {
          "type": "number"
        },
        "month": {
          "type": "number"
        },
        "slides": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Slide"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "title",
        "year",
        "month",
        "slides"
      ],
      "additionalProperties": false
    },
    "Slide": {
      "anyOf": [
        {
          "$ref": "#/definitions/TitleSlide"
        },
        {
          "$ref": "#/definitions/ContentSlide"
        },
        {
          "$ref": "#/definitions/CodeSlide"
        },
        {
          "$ref": "#/definitions/ImageSlide"
        },
        {
          "$ref": "#/definitions/BlankSlide"
        },
        {
          "$ref": "#/definitions/TableSlide"
        },
        {
          "$ref": "#/definitions/SpeakerSlide"
        },
        {
          "$ref": "#/definitions/MixedSlide"
        }
      ]
    },
    "TitleSlide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Speaker notes, shown only in the presenter view, never to the audience."
        },
        "background": {
          "type": "string",
          "description": "Image shown behind the slide's own content, dimmed for readability. Available on every layout."
        },
        "layout": {
          "type": "string",
          "const": "title"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "layout",
        "title"
      ],
      "additionalProperties": false
    },
    "ContentSlide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Speaker notes, shown only in the presenter view, never to the audience."
        },
        "background": {
          "type": "string",
          "description": "Image shown behind the slide's own content, dimmed for readability. Available on every layout."
        },
        "layout": {
          "type": "string",
          "const": "content"
        },
        "title": {
          "type": "string"
        },
        "bullets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Bullet"
          }
        }
      },
      "required": [
        "bullets",
        "id",
        "layout",
        "title"
      ],
      "additionalProperties": false
    },
    "Bullet": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "fragment": {
          "type": "boolean",
          "description": "Hidden until revealed one at a time via click/arrow key, instead of shown immediately with the rest of the slide."
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "CodeSlide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Speaker notes, shown only in the presenter view, never to the audience."
        },
        "background": {
          "type": "string",
          "description": "Image shown behind the slide's own content, dimmed for readability. Available on every layout."
        },
        "layout": {
          "type": "string",
          "const": "code"
        },
        "title": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional versions of the code, morphed through one at a time (Shiki Magic Move) before advancing to the next slide."
        }
      },
      "required": [
        "code",
        "id",
        "language",
        "layout"
      ],
      "additionalProperties": false
    },
    "ImageSlide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Speaker notes, shown only in the presenter view, never to the audience."
        },
        "background": {
          "type": "string",
          "description": "Image shown behind the slide's own content, dimmed for readability. Available on every layout."
        },
        "layout": {
          "type": "string",
          "const": "image"
        },
        "title": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        }
      },
      "required": [
        "alt",
        "id",
        "layout",
        "src"
      ],
      "additionalProperties": false
    },
    "BlankSlide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Speaker notes, shown only in the presenter view, never to the audience."
        },
        "background": {
          "type": "string",
          "description": "Image shown behind the slide's own content, dimmed for readability. Available on every layout."
        },
        "layout": {
          "type": "string",
          "const": "blank"
        },
        "heading": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "layout"
      ],
      "additionalProperties": false
    },
    "TableSlide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Speaker notes, shown only in the presenter view, never to the audience."
        },
        "background": {
          "type": "string",
          "description": "Image shown behind the slide's own content, dimmed for readability. Available on every layout."
        },
        "layout": {
          "type": "string",
          "const": "table"
        },
        "title": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TableRow"
          }
        },
        "empty": {
          "type": "boolean"
        },
        "caption": {
          "type": "string"
        },
        "ascii": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "description": "Replaces the ascii-art slot with a real image instead — mutually exclusive with `ascii` in practice, but both are independently optional."
        },
        "imageAlt": {
          "type": "string"
        }
      },
      "required": [
        "columns",
        "id",
        "layout",
        "rows"
      ],
      "additionalProperties": false
    },
    "TableRow": {
      "type": "object",
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variant": {
          "$ref": "#/definitions/TableRowVariant"
        }
      },
      "required": [
        "cells"
      ],
      "additionalProperties": false
    },
    "TableRowVariant": {
      "type": "string",
      "enum": [
        "normal",
        "highlight",
        "danger",
        "deleted",
        "warning"
      ]
    },
    "SpeakerSlide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Speaker notes, shown only in the presenter view, never to the audience."
        },
        "background": {
          "type": "string",
          "description": "Image shown behind the slide's own content, dimmed for readability. Available on every layout."
        },
        "layout": {
          "type": "string",
          "const": "speaker"
        },
        "heading": {
          "type": "string"
        },
        "photo": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "website": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "twitter": {
          "type": "string"
        },
        "bluesky": {
          "type": "string"
        },
        "mastodon": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "layout"
      ],
      "additionalProperties": false
    },
    "MixedSlide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Speaker notes, shown only in the presenter view, never to the audience."
        },
        "background": {
          "type": "string",
          "description": "Image shown behind the slide's own content, dimmed for readability. Available on every layout."
        },
        "layout": {
          "type": "string",
          "const": "mixed"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentBlock"
          }
        }
      },
      "required": [
        "blocks",
        "id",
        "layout"
      ],
      "additionalProperties": false
    },
    "ContentBlock": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "heading"
            },
            "level": {
              "type": "number",
              "enum": [
                1,
                2
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "level",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bullets"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Bullet"
              }
            }
          },
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paragraph"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "code"
            },
            "language": {
              "type": "string"
            },
            "code": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "language",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
